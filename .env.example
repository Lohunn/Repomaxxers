# Google Gemini API Key (required for root, intake, planner, notifier agents)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Vertex AI toggle (set to FALSE to use direct Google AI Studio Gemini API)
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Google Maps Platform API Key (required for real Routes API computeRoutes)
# Get from: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Cloud Project ID (used for Firestore native mode and Cloud Run deployment)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional auth token for /location telemetry ingestion endpoint
TRACKER_TOKEN=dispatch-secret-token-123

# Optional secondary LLM provider key for CriticAgent (LiteLlm multi-model testing)
# If omitted, CriticAgent automatically falls back to Gemini model family via LiteLlm
OPENAI_API_KEY=

# Demo-safe flags (Default to false in production; set to true for zero-setup demo mode)
USE_MOCK_ROUTES=false
USE_LOCAL_STORE=false

# Default vehicle ID for single-vehicle dispatch tracking
DEFAULT_VEHICLE_ID=driver-1
